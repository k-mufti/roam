# ---------------------------------------------------------------------------
# Trip Package — environment configuration
#
# Copy to `.env`. EVERY external key below is optional: each ingestion source
# falls back to checked-in fixture data when its key is absent, so the full
# pipeline runs with this file untouched.
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql+psycopg://trip:trip@localhost:55432/trip_package

# Target city for v1. Single city by design (see README "Scope"); this is a
# real config value rather than a hardcoded literal so adding a city later is
# a data change, not a refactor.
TARGET_CITY=Madrid

# --- Optional source credentials -------------------------------------------
# Absent key => that source runs in `fixture` mode automatically.

# Google Places (New). Requires a GCP project with billing enabled.
GOOGLE_PLACES_API_KEY=

# Yelp Fusion. Free tier, 500 req/day.
YELP_API_KEY=

# Reddit. Optional even for live mode: without these we use the public
# read-only JSON endpoints (lower rate limits). With them we use OAuth.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trip-package/0.1 (portfolio project)

# --- Routing ---------------------------------------------------------------
# `osrm` | `google` | `haversine`. Defaults to trying OSRM then degrading to
# haversine. The public demo server is rate-limited and not for production.
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
GOOGLE_DIRECTIONS_API_KEY=

# Force every ingestion source into fixture mode regardless of keys present.
# Useful for deterministic tests and offline demos.
INGESTION_FORCE_FIXTURES=false
