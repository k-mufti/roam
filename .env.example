# ---------------------------------------------------------------------------
# Roam — environment configuration
#
# Copy to `.env`. EVERY external key below is optional: each ingestion source
# falls back to checked-in fixture data when its key is absent, so the full
# pipeline runs with this file untouched.
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql+psycopg://roam:roam@localhost:55432/roam

# Target city for v1. Single city by design (see README "Scope"); this is a
# real config value rather than a hardcoded literal so adding a city later is
# a data change, not a refactor.
TARGET_CITY=Madrid

# --- Optional source credentials -------------------------------------------
# Absent key => that source runs in `fixture` mode automatically.

# Google Places (New). Requires a GCP project with billing enabled.
GOOGLE_PLACES_API_KEY=

# Yelp Fusion. Free tier, 500 req/day.
YELP_API_KEY=

# Reddit. Optional even for live mode: without these we use the public
# read-only JSON endpoints (lower rate limits). With them we use OAuth.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=roam/0.1 (portfolio project)

# --- Routing ---------------------------------------------------------------
# `haversine` | `osrm` | `google`.
#
# haversine is the DEFAULT on purpose. The public OSRM demo server
# (router.project-osrm.org) only has the car profile built: it returns identical
# results for foot/walking/driving, and because it routes on the road graph it
# sends you around pedestrianized streets — Puerta del Sol to Plaza Mayor, a
# 5-minute walk, comes back as ~3.7km / 49 minutes. Setting ROUTING_PROVIDER=osrm
# against that host logs a warning and falls back to haversine.
#
# To use real routing, self-host OSRM with the foot profile (see README) and
# point OSRM_BASE_URL at it; durations are then trusted automatically.
ROUTING_PROVIDER=haversine
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_ALLOW_PUBLIC_DEMO=false
GOOGLE_DIRECTIONS_API_KEY=

# Travel mode for itinerary legs: walk | transit | drive
TRAVEL_MODE=walk

# Force every ingestion source into fixture mode regardless of keys present.
# Useful for deterministic tests and offline demos.
INGESTION_FORCE_FIXTURES=false
